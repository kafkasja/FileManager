<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (API 23-30) (TASK-N1): the device identity in flutter_secure_storage
     must never reach another phone. Its AES key lives in the Android Keystore and
     doesn't travel, and a copied identity would make two phones look the same. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
</full-backup-content>
